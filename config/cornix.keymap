#include "zmk-helpers/helper.h"
#include "includes/cornix54.h"

// tap windows for ctl alt and gui

#define HM_TAPPING_TERM 250
#define HM_TAPPING_REPEAT 210

// quick tapping for shift

#define HM_TAPPING_TERM_FAST 200
#define HM_PRIOR_IDLE 70
#define BASE 0
#define WIN 1
#define LOWER 2
#define RAISE 3
#define ADJUST 4
#define NAVI   5
#define NUM    6
#define DEBUG  7

// https://github.com/urob/zmk-config/tree/main#timeless-homerow-mods

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5  // left hand
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5  // right hand
#define THUMBS LH1 LH0 RH0 RH1
#define KEYS_T LH1 LH0 RH0 RH1
#define ZMK_POINTING_DEFAULT_SCRL_VAL 15

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    // Activate ADJUST layer by pressing raise and lower

    behaviors {
        // Positional Homerow mods for shift
        // Use faster tapping term and disable some features that may
        // cause false negatives.
        /*
         * Non-Positional Homerow Mods
         * Used for &mm_grescm_gui behavior on left hand.
         *
         * Usage: &hm LSHFT T
         * Tap: T
         * Tap-Tap-Hold: Repeat T
         * Hold: LSHIFT
         */

        mo_sl: mo_sl {
            compatible = "zmk,behavior-hold-tap";
            label = "MO_SL";
            bindings = <&mo>, <&sl>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            hold-while-undecided;
            hold-trigger-on-release;
        };

        kp_sk: kp_sk {
            compatible = "zmk,behavior-hold-tap";
            label = "KP_SK";
            bindings = <&kp>, <&sk>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            hold-while-undecided;
            hold-trigger-on-release;
        };

        alt_win_: alt_win_ {
            compatible = "zmk,behavior-tap-dance";
            label = "ALT_WIN_";
            #binding-cells = <0>;
            bindings = <&kp LEFT_ALT>, <&kp LEFT_WIN>, <&kp LA(LEFT_WIN)>;

            tapping-term-ms = <300>;
        };

        shift_ctrl_: shift_ctrl_ {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFT_CTRL_";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp LCTRL>, <&kp LS(LCTRL)>;

            tapping-term-ms = <300>;
        };

        win_shift: win_shift {
            compatible = "zmk,behavior-tap-dance";
            label = "WIN_SHIFT";
            #binding-cells = <0>;
            bindings = <&kp LEFT_WIN>, <&kp LS(LEFT_WIN)>;

            tapping-term-ms = <300>;
        };

        ctrl_shift: ctrl_shift {
            compatible = "zmk,behavior-tap-dance";
            label = "CTRL_SHIFT";
            #binding-cells = <0>;
            bindings = <&kp LCTRL>, <&kp LS(LCTRL)>;

            tapping-term-ms = <300>;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };

    combos {
        compatible = "zmk,combos";

        cb_delete_left {
            bindings = <&kp DELETE>;
            key-positions = <0 1>;
            layers = <1 2 3 4 5>;
        };

        cb_delete_right {
            bindings = <&kp DELETE>;
            key-positions = <10 11>;
        };

        cb_tab {
            bindings = <&kp TAB>;
            key-positions = <12 13>;
        };

        cb_space_left {
            bindings = <&kp SPACE>;
            key-positions = <15 16>;
        };

        cb_space_right {
            bindings = <&kp SPACE>;
            key-positions = <19 20>;
        };

        cb_enter_left {
            bindings = <&kp ENTER>;
            key-positions = <28 29>;
        };

        cb_enter_right {
            bindings = <&kp ENTER>;
            key-positions = <33 32>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&kp GRAVE     &kp Q        &kp W       &kp E       &kp R      &kp T                         &kp Y      &kp U      &kp I       &kp O       &kp P        &kp BSPC
&kp ESCAPE    &kp A        &kp S       &kp D       &kp F      &kp G                         &kp H      &kp J      &kp K       &kp L       &kp SEMI     &kp SQT
&shift_ctrl_  &kp Z        &kp X       &kp C       &kp V      &kp B      &kp K_MUTE  &none  &kp N      &kp M      &kp COMMA   &kp DOT     &kp FSLH     &shift_ctrl_
&mo_sl 4 4    &ctrl_shift  &win_shift  &mo_sl 1 1  &alt_win_  &kp SPACE                     &kp SPACE  &alt_win_  &mo_sl 1 1  &win_shift  &ctrl_shift  &mo_sl 4 4
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>,
                <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>;
        };

        thumb_shallow {
            bindings = <
&kp BACKSPACE  &kp N1            &kp N2             &kp N3         &kp N4     &kp N5                   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp N7      &kp N8  &kp N9   &trans
&trans         &kp N6            &kp N7             &kp N8         &kp N9     &kp N0                   &kp KP_MULTIPLY       &kp KP_DIVIDE          &kp N4      &kp N5  &kp N6   &kp ESCAPE
&trans         &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH  &kp MINUS  &kp EQUAL  &none  &none  &kp KP_PLUS           &kp KP_MINUS           &kp N1      &kp N2  &kp N3   &trans
&none          &trans            &trans             &mo_sl 2 2     &trans     &trans                   &trans                &trans                 &mo_sl 2 2  &kp N0  &kp DOT  &none
            >;
        };

        thumb_deep {
            bindings = <
&kp BACKSPACE  &kp F1  &kp F2  &kp F3      &kp F4   &kp F5                 &kp F1  &kp F2  &kp F3      &kp F4   &kp F5   &trans
&trans         &kp F6  &kp F7  &kp F8      &kp F9   &kp F10                &kp F6  &kp F7  &kp F8      &kp F9   &kp F10  &kp ESCAPE
&trans         &none   &none   &none       &kp F11  &kp F12  &none  &none  &none   &none   &none       &kp F11  &kp F12  &trans
&none          &trans  &trans  &mo_sl 3 3  &trans   &trans                 &trans  &trans  &mo_sl 3 3  &none    &none    &none
            >;
        };

        thumb_abyss {
            bindings = <
&none  &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4                                   &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4   &none
&none  &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4                                  &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4  &none
&none  &none          &none          &bt BT_CLR     &none          &none          &bt BT_CLR_ALL  &bt BT_CLR_ALL  &none          &none          &bt BT_CLR     &none          &none          &none
&none  &none          &none          &none          &none          &none                                          &none          &none          &none          &none          &none          &none
            >;
        };

        pinky_sallow {
            bindings = <
&kp BACKSPACE  &none     &kp UP_ARROW  &none      &none   &none                   &none     &none     &none   &none      &none   &trans
&trans         &kp LEFT  &kp DOWN      &kp RIGHT  &none   &none                   &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &none   &kp ESCAPE
&trans         &none     &none         &none      &none   &none   &trans  &trans  &none     &none     &none   &none      &none   &trans
&mo_sl 5 5     &trans    &trans        &none      &trans  &trans                  &trans    &trans    &none   &trans     &trans  &mo_sl 5 5
            >;
        };

        pinky_deep {
            bindings = <
&kp BACKSPACE  &none         &kp PAGE_UP    &none         &none         &none                         &none         &none          &none         &none         &none         &trans
&trans         &kp HOME      &kp PAGE_DOWN  &kp END       &none         &none                         &kp HOME      &kp PAGE_DOWN  &kp PAGE_UP   &kp END       &none         &kp ESCAPE
&trans         &bt BT_SEL 0  &bt BT_SEL 1   &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1   &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans
&none          &trans        &trans         &none         &trans        &trans                        &trans        &trans         &none         &trans        &trans        &none
            >;
        };
    };
};
