#include "zmk-helpers/helper.h"
#include "includes/cornix54.h"

// tap windows for ctl alt and gui

#define HM_TAPPING_TERM 250
#define HM_TAPPING_REPEAT 210

// quick tapping for shift

#define HM_TAPPING_TERM_FAST 200
#define HM_PRIOR_IDLE 70
#define BASE 0
#define WIN 1
#define LOWER 2
#define RAISE 3
#define ADJUST 4
#define NAVI   5
#define NUM    6
#define DEBUG  7

// https://github.com/urob/zmk-config/tree/main#timeless-homerow-mods

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5  // left hand
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5  // right hand
#define THUMBS LH1 LH0 RH0 RH1
#define KEYS_T LH1 LH0 RH0 RH1
#define ZMK_POINTING_DEFAULT_SCRL_VAL 15

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    // Activate ADJUST layer by pressing raise and lower

    behaviors {
        // Positional Homerow mods for shift
        // Use faster tapping term and disable some features that may
        // cause false negatives.
        /*
         * Non-Positional Homerow Mods
         * Used for &mm_grescm_gui behavior on left hand.
         *
         * Usage: &hm LSHFT T
         * Tap: T
         * Tap-Tap-Hold: Repeat T
         * Hold: LSHIFT
         */

        mo_sl: mo_sl {
            compatible = "zmk,behavior-hold-tap";
            label = "MO_SL";
            bindings = <&mo>, <&sl>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            hold-while-undecided;
            hold-trigger-on-release;
        };

        kp_sk: kp_sk {
            compatible = "zmk,behavior-hold-tap";
            label = "KP_SK";
            bindings = <&kp>, <&sk>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            hold-while-undecided;
            hold-trigger-on-release;
        };

        alt_win: alt_win {
            compatible = "zmk,behavior-tap-dance";
            label = "ALT_WIN";
            #binding-cells = <0>;
            bindings =
                <&kp_sk LEFT_ALT LEFT_ALT>,
                <&kp_sk LEFT_WIN LEFT_WIN>,
                <&kp_sk LA(LEFT_WIN) LA(LEFT_WIN)>;

            tapping-term-ms = <300>;
        };

        shift_ctrl: shift_ctrl {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFT_CTRL";
            #binding-cells = <0>;
            bindings =
                <&kp_sk RIGHT_SHIFT RIGHT_SHIFT>,
                <&kp_sk RIGHT_CONTROL RIGHT_CONTROL>,
                <&kp_sk RS(RIGHT_CONTROL) RS(RIGHT_CONTROL)>;

            tapping-term-ms = <300>;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };

    combos {
        compatible = "zmk,combos";

        cb_delete_left {
            bindings = <&kp DELETE>;
            key-positions = <0 1>;
            layers = <1 2>;
        };

        cb_delete_right {
            bindings = <&kp DELETE>;
            key-positions = <10 11>;
        };

        cb_tab {
            bindings = <&kp TAB>;
            key-positions = <12 13>;
        };

        cb_space_left {
            bindings = <&kp SPACE>;
            key-positions = <15 16>;
        };

        cb_space_right {
            bindings = <&kp SPACE>;
            key-positions = <19 20>;
        };

        cb_enter_left {
            bindings = <&kp ENTER>;
            key-positions = <28 29>;
        };

        cb_enter_right {
            bindings = <&kp ENTER>;
            key-positions = <33 32>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&kp GRAVE    &kp Q     &kp W      &kp E       &kp R     &kp T                         &kp Y      &kp U     &kp I       &kp O     &kp P     &kp BSPC
&kp ESCAPE   &kp A     &kp S      &kp D       &kp F     &kp G                         &kp H      &kp J     &kp K       &kp L     &kp SEMI  &kp SQT
&shift_ctrl  &kp Z     &kp X      &kp C       &kp V     &kp B      &kp K_MUTE  &none  &kp N      &kp M     &kp COMMA   &kp DOT   &kp FSLH  &shift_ctrl
&mo_sl 3 3   &kp LEFT  &kp RIGHT  &mo_sl 1 1  &alt_win  &kp SPACE                     &kp SPACE  &alt_win  &mo_sl 1 1  &kp DOWN  &kp UP    &mo_sl 3 3
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>,
                <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>;
        };

        thumb_shallow {
            bindings = <
&kp BACKSPACE  &kp KP_DIVIDE    &kp N7  &kp N8      &kp N9  &kp UNDERSCORE                  &kp EXCLAMATION   &kp AT_SIGN        &kp POUND      &kp DOLLAR        &none          &trans
&trans         &kp KP_MULTIPLY  &kp N4  &kp N5      &kp N6  &kp EQUAL                       &kp PERCENT       &kp CARET          &kp AMPERSAND  &kp ASTERISK      &kp BACKSLASH  &none
&trans         &kp KP_MINUS     &kp N1  &kp N2      &kp N3  &kp DOT         &trans  &trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LESS_THAN  &kp GREATER_THAN  &kp SLASH      &trans
&none          &kp KP_PLUS      &kp N0  &mo_sl 2 2  &trans  &trans                          &trans            &trans             &mo_sl 2 2     &mkp LCLK         &mkp RCLK      &none
            >;
        };

        thumb_deep {
            bindings = <
&kp BACKSPACE  &none  &kp F7  &kp F8  &kp F9  &kp F10                  &none           &none            &none                 &none                  &none         &trans
&trans         &none  &kp F4  &kp F5  &kp F6  &kp F11                  &none           &none            &none                 &none                  &kp PIPE      &none
&trans         &none  &kp F1  &kp F2  &kp F3  &kp F12  &trans  &trans  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp QUESTION  &trans
&none          &none  &none   &none   &trans  &none                    &none           &trans           &none                 &none                  &none         &none
            >;
        };

        pinky_sallow {
            bindings = <
&none       &none     &kp UP_ARROW  &none      &none   &none                   &none     &none     &none   &none      &none  &trans
&trans      &kp LEFT  &kp DOWN      &kp RIGHT  &none   &none                   &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &none  &none
&trans      &none     &none         &none      &none   &none   &trans  &trans  &none     &none     &none   &none      &none  &trans
&mo_sl 4 4  &none     &none         &none      &trans  &trans                  &trans    &trans    &none   &none      &none  &mo_sl 4 4
            >;
        };

        pinky_deep {
            bindings = <
&bt BT_CLR_ALL  &none         &kp PAGE_UP    &none         &none         &none                         &none         &none          &none         &none         &none         &bt BT_CLR_ALL
&trans          &kp HOME      &kp PAGE_DOWN  &kp END       &none         &none                         &kp HOME      &kp PAGE_DOWN  &kp PAGE_UP   &kp END       &none         &none
&trans          &bt BT_SEL 0  &bt BT_SEL 1   &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1   &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans
&none           &none         &none          &none         &trans        &none                         &none         &trans         &none         &none         &none         &none
            >;
        };
    };
};
